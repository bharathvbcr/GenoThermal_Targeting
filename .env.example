# Copy this file to .env and fill in your keys. .env is gitignored — never commit real keys.

# AlphaGenome (Phase 1 expression oracle). Get a key:
#   https://deepmind.google.com/science/alphagenome
ALPHAGENOME_API_KEY=

# Bright Data (live target intel via SERP / Web Unlocker, fanned out on Flash).
# Token from your Bright Data dashboard (Account settings -> API tokens).
# Also used by the Bright Data MCP server in .mcp.json (env var name must match).
BRIGHTDATA_API_TOKEN=
# Optional: override the zone names provisioned in your Bright Data account.
BRIGHTDATA_SERP_ZONE=serp_api
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker

# RunPod Flash. Either run `flash login` (saves a token) OR set this key.
# Provisions/runs the @Endpoint fan-outs (flash_fitness, flash_boltz, flash_gpu_jobs,
# bright_data_intel) on RunPod serverless. Get it: RunPod dashboard -> Settings -> API Keys.
RUNPOD_API_KEY=

# NVIDIA BioNeMo (independent Boltz-2 verifier). Get it: https://build.nvidia.com
NVIDIA_API_KEY=
