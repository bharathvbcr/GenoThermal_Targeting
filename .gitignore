# Flash run artifacts (regenerated each run)
flash_metrics.json
flash_scaling.png
# Live monitor status snapshot + shareable static export (regenerated each run by pipeline_monitor.py)
outputs/reports/pipeline_status.json
outputs/reports/pipeline_report.html
_preflight*.json
_preflight*.png

# Stray figures at the repo root or in hard_mode/ — the canonical copies live in
# outputs/figures/ (written there by the hard_mode scripts). Older runs dropped
# duplicates here; ignore them so they don't get re-committed.
/*.png
/hard_mode/*.png

# Pipeline outputs (note: outputs/reports/candidate_library*.csv and
# outputs/reports/target_report.json are already git-tracked sample outputs,
# so they're intentionally NOT ignored here)
*.log
panel_selectivity*.csv
panel_selectivity*_matrix.csv

# Secrets — never commit API keys/tokens (ALPHAGENOME_API_KEY, BRIGHTDATA_API_TOKEN, ...)
.env
.env.*
!.env.example

# Generated intel/leaderboard outputs
target_intel.json
leaderboard.csv

# Python
__pycache__/
*.pyc
.venv/
.venv-flash/
*.egg-info/

# OS junk
.DS_Store
# Office temp/lock files
~$*

# Machine-local Claude Code settings (per-machine permissions, not shared)
.claude/settings.local.json

# Stdout capture + partial/in-progress fold artifacts (regenerated each run)
pipeline_run.out
pipeline_run*.out
*.partial.csv

# Presentation / demo deliverables — not part of the code submission
# (decks + their PDF exports + the demo walkthrough are produced locally, not committed)
*.pptx
*.pdf
DEMO_SCRIPT.md

# Training/run dumps (regenerated each run)
ppo_gene_tensorboard/
*.sqlite
*.sqlite3
*.dmp
*.dump

# Scratch/working notes (not project documentation)
FLASH_HACKATHON_NOTES.md
GenoThermal_Resume_Points.md
PATCHING_PLAN.md
